<formLayout xmlns="http://polarion.com/schema/WorkItems/FormLayout" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://polarion.com/schema/WorkItems/FormLayout">
  <horizontal>
    <vertical>
      <section>
        <field id="type"/>
        <field id="project"/>
      </section>
    </vertical>
  </horizontal>
  <field id="description"/>
  <panel description="Generic Capella Fields">
    <field id="uuid_capella" readOnly="true"/>
    <field id="checksum" readOnly="true"/>
    <field id="parent" readOnly="true"/>
    <field id="parent_reverse" readOnly="true"/>
    <field id="layer" readOnly="false"/>
  </panel>
  <panel description="Custom Fields">
    <field id="@allCustomFields,-owner,-sortOrder,-manualQuality,-qualitySuspect,-automatics,-language,-uuid_capella,-checksum,-parent,-parent_reverse,-layer,-rationale,-assumption,-context_diagram,-realization_view,-nextTeam,-oldID,-notes" readOnly="false"/>
    <field id="context_diagram" readOnly="false"/>
  </panel>
  <panel description="Rationale and Assumption">
    <field id="rationale" readOnly="false"/>
    <field id="assumption" readOnly="false"/>
  </panel>
  <field id="comments"/>
  <field id="linkedWorkItems"/>
  <field id="hyperlinks"/>
</formLayout>
